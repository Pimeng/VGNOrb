<Window x:Class="VGNOrb.App.Views.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VGNOrb.App.Views"
        Title="VGN Orb"
        Width="132"
        Height="132"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Topmost="{Binding AlwaysOnTop, Mode=OneWay}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     FontFamily="{StaticResource AppFont}">
            <MenuItem Header="{Binding TraySummary}" IsEnabled="False" FontWeight="SemiBold" />
            <Separator />
            <MenuItem Header="刷新全部电量" Command="{Binding RefreshAllCommand}" />
            <MenuItem Header="重新发现并连接" Command="{Binding ReconnectAllCommand}" />
            <MenuItem Header="断开全部设备" Command="{Binding DisconnectAllCommand}" />
            <Separator />
            <MenuItem Header="始终置顶"
                      IsCheckable="True"
                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
            <Separator />
            <MenuItem Header="隐藏到托盘" Click="OnHideClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="LayoutRoot" Margin="8" Background="Transparent" Opacity="0">
        <ItemsControl ItemsSource="{Binding Devices}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Visibility="{Binding HasDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:DeviceTile
                        Width="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Height="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Width="{Binding TileSize}"
              Height="{Binding TileSize}"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDevices}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Ellipse Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#303EDCFF" Offset="0.58" />
                        <GradientStop Color="#0D3EDCFF" Offset="0.82" />
                        <GradientStop Color="#003EDCFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.42,0.32" GradientOrigin="0.35,0.22" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#2A4261" Offset="0" />
                        <GradientStop Color="#14243B" Offset="0.46" />
                        <GradientStop Color="#070C16" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#35D8FF" BlurRadius="16" ShadowDepth="0" Opacity="0.4" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="104" Height="104"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#4C6FFF"
                     StrokeThickness="1.2" />
            <TextBlock Text="VGN ORB"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,27,0,0"
                       FontSize="6.8"
                       FontWeight="SemiBold"
                       Foreground="#78A9C5" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="--"
                           HorizontalAlignment="Center"
                           FontFamily="Bahnschrift SemiBold, Segoe UI, Microsoft YaHei UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#72869C" />
                <TextBlock Text="未连接"
                           HorizontalAlignment="Center"
                           Margin="0,-1,0,0"
                           FontSize="7.3"
                           Foreground="#88AEC5" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,15"
                       MaxWidth="98"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="7"
                       Foreground="#52758E" />
        </Grid>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LayoutRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
