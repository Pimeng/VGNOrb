<Window x:Class="VGNOrb.App.Views.DeviceHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VGNOrb.App.Controls"
        Title="VGN Orb"
        Width="300"
        Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Topmost="{Binding AlwaysOnTop, Mode=OneWay}"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="NeonGreenBrush" Color="#3CFF00" />

        <Style x:Key="HudTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="GeosansLight, Segoe UI" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="HudIdentifyStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="GeosansLight, Segoe UI" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HudPercentStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="GeosansLight, Segoe UI" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid x:Name="HudRoot" Background="Transparent" Opacity="0">
        <Border Width="300" CornerRadius="0,0,0,30" Background="#000000"
                RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <!-- Single device: exact 300x100 layout from the MCP "单设备" group. -->
                <Canvas Width="300" Height="100"
                        Visibility="{Binding DataContext.IsSingleDevice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                        DataContext="{Binding PrimaryDevice}">
                    <Grid Canvas.Left="12" Canvas.Top="10" Width="80" Height="80">
                        <controls:BatteryRing Width="80"
                                              Height="80"
                                              Value="{Binding BatteryPercent}"
                                              TrackBrush="#17300B"
                                              ProgressBrush="{StaticResource NeonGreenBrush}"
                                              StrokeThickness="4" />
                    </Grid>

                    <TextBlock Canvas.Left="96"
                               Canvas.Top="4"
                               Width="190"
                               Text="{Binding HudName}"
                               Style="{StaticResource HudTitleStyle}"
                               FontSize="26" />

                    <TextBlock Canvas.Left="100"
                               Canvas.Top="53"
                               Width="110"
                               Text="{Binding IdentifyText}"
                               Style="{StaticResource HudIdentifyStyle}"
                               FontSize="15" />

                    <TextBlock Canvas.Left="207"
                               Canvas.Top="41"
                               Width="62"
                               Text="{Binding BatteryText}"
                               Style="{StaticResource HudPercentStyle}"
                               FontSize="34" />
                </Canvas>

                <!-- Two devices: exact 300x200 layout from the MCP "单设备" 9-child group. -->
                <Canvas Width="300" Height="200"
                        Visibility="{Binding IsDualDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Canvas.DataContext>
                        <Binding />
                    </Canvas.DataContext>

                    <Grid Canvas.Left="12" Canvas.Top="10" Width="80" Height="80"
                          DataContext="{Binding PrimaryDevice}">
                        <controls:BatteryRing Width="80"
                                              Height="80"
                                              Value="{Binding BatteryPercent}"
                                              TrackBrush="#17300B"
                                              ProgressBrush="{StaticResource NeonGreenBrush}"
                                              StrokeThickness="4" />
                    </Grid>
                    <TextBlock Canvas.Left="96"
                               Canvas.Top="4"
                               Width="190"
                               DataContext="{Binding PrimaryDevice}"
                               Text="{Binding HudName}"
                               Style="{StaticResource HudTitleStyle}"
                               FontSize="26" />
                    <TextBlock Canvas.Left="100"
                               Canvas.Top="53"
                               Width="110"
                               DataContext="{Binding PrimaryDevice}"
                               Text="{Binding IdentifyText}"
                               Style="{StaticResource HudIdentifyStyle}"
                               FontSize="15" />
                    <TextBlock Canvas.Left="207"
                               Canvas.Top="41"
                               Width="62"
                               DataContext="{Binding PrimaryDevice}"
                               Text="{Binding BatteryText}"
                               Style="{StaticResource HudPercentStyle}"
                               FontSize="34" />

                    <Grid Canvas.Left="12" Canvas.Top="106" Width="80" Height="80"
                          DataContext="{Binding SecondaryDevice}">
                        <controls:BatteryRing Width="80"
                                              Height="80"
                                              Value="{Binding BatteryPercent}"
                                              TrackBrush="#17300B"
                                              ProgressBrush="{StaticResource NeonGreenBrush}"
                                              StrokeThickness="4" />
                    </Grid>
                    <TextBlock Canvas.Left="96"
                               Canvas.Top="100"
                               Width="190"
                               DataContext="{Binding SecondaryDevice}"
                               Text="{Binding HudName}"
                               Style="{StaticResource HudTitleStyle}"
                               FontSize="26" />
                    <TextBlock Canvas.Left="100"
                               Canvas.Top="146"
                               Width="110"
                               DataContext="{Binding SecondaryDevice}"
                               Text="{Binding IdentifyText}"
                               Style="{StaticResource HudIdentifyStyle}"
                               FontSize="15" />
                    <TextBlock Canvas.Left="207"
                               Canvas.Top="134"
                               Width="62"
                               DataContext="{Binding SecondaryDevice}"
                               Text="{Binding BatteryText}"
                               Style="{StaticResource HudPercentStyle}"
                               FontSize="34" />
                </Canvas>

                <!-- Empty state -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDevices}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="64" Height="64" Stroke="#21412B" StrokeThickness="4" />
                        <TextBlock Text="NO DEVICE"
                                   HorizontalAlignment="Center"
                                   Foreground="#687868"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HudRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.16" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>

